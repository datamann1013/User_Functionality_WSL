# Optimized Frontend React Dockerfile (Multi-stage build)
FROM node:18-alpine AS builder

# Set working directory
WORKDIR /app

# Copy package files first for better caching
COPY frontend/package*.json ./

# Install dependencies (including devDependencies for building)
RUN npm install --silent

# Copy source code
COPY frontend/src/ ./src/
COPY frontend/public/ ./public/

# Build for production
RUN npm run build

# Production stage
FROM nginx:alpine

# Copy built app to nginx
COPY --from=builder /app/build /usr/share/nginx/html

# Copy optimized nginx configuration
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# Ensure permissions. Avoid installing packages during image build to keep
# builds fast and hermetic in environments without outbound network access.
RUN chown -R root:root /usr/share/nginx/html /var/cache/nginx /var/run /var/log/nginx \
    && mkdir -p /run && chown -R root:root /run

EXPOSE 3000

CMD ["nginx", "-g", "daemon off;"]
