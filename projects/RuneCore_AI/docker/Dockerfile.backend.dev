FROM runecore/python-slim-dev:latest
WORKDIR /app

# Copy requirements and install Python dependencies as root so binaries
# (gunicorn) are installed into a system location (e.g. /usr/local/bin)
# that is available to the non-root `dev` user in the base image.
USER root
COPY projects/RuneCore_AI/backend/requirements.txt /app/requirements.txt
RUN set -eux; \
    python -m pip install --upgrade pip setuptools wheel; \
    python -m pip install --no-cache-dir -r /app/requirements.txt; \
    python -m pip install --no-cache-dir psycopg2-binary gunicorn; \
    rm -rf /root/.cache/pip

# Copy application code (optimized layering)
COPY projects/RuneCore_AI/backend/ /app/backend/
COPY projects/shared_utils/ /app/shared_utils/
COPY projects/RuneGuard_Logger/ /app/ErrorLogger/

# Create necessary directories
RUN mkdir -p /app/uploads /app/logs && chown -R dev:dev /app && chmod 777 /app/logs

# Switch back to non-root user provided by the dev base image
USER dev

HEALTHCHECK --interval=60s --timeout=5s --start-period=30s --retries=2 \
    CMD curl -f http://localhost:5000/health || exit 1

EXPOSE 5000
WORKDIR /app/backend
CMD ["gunicorn", "--bind", "0.0.0.0:5000", "--workers", "2", "app:app"]
