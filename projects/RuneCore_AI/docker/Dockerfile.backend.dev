FROM runecore/python-slim-dev:latest
WORKDIR /app

# Copy requirements and install Python dependencies
COPY projects/RuneCore_AI/backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir psycopg2-binary gunicorn

# Copy application code (optimized layering)
COPY projects/RuneCore_AI/backend/ /app/backend/
COPY projects/shared_utils/ /app/shared_utils/
COPY projects/RuneGuard_Logger/ /app/ErrorLogger/

# Create necessary directories
RUN mkdir -p /app/uploads /app/logs && chmod 777 /app/logs

HEALTHCHECK --interval=60s --timeout=5s --start-period=30s --retries=2 \
    CMD curl -f http://localhost:5000/health || exit 1

EXPOSE 5000
WORKDIR /app/backend
CMD ["gunicorn", "--bind", "0.0.0.0:5000", "--workers", "2", "app:app"]
