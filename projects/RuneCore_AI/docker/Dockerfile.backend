# Optimized Backend API Dockerfile
FROM python:3.11-alpine

# Set working directory
WORKDIR /app

# Install build dependencies, system dependencies, and Redis server
RUN apk add --no-cache curl postgresql-client gcc python3-dev musl-dev linux-headers redis supervisor

# Copy requirements and install Python dependencies
COPY projects/ai_service/backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir --disable-pip-version-check -r requirements.txt \
    && pip install --no-cache-dir psycopg2-binary gunicorn

# Copy application code (optimized layering)
COPY projects/ai_service/backend/ /app/backend/
COPY projects/shared_utils/ /app/shared_utils/
COPY projects/ErrorLogger/ /app/ErrorLogger/

# Create necessary directories and Redis configuration
RUN mkdir -p /app/uploads /app/logs /var/log/redis /var/lib/redis /etc/supervisor/conf.d && \
    chmod 755 /app/uploads && chmod 777 /app/logs && \
    chmod 755 /var/lib/redis /var/log/redis

# Configure Redis for AI Cache
RUN echo "# RuneCore AI Service Redis Configuration" > /etc/redis.conf && \
    echo "bind 127.0.0.1" >> /etc/redis.conf && \
    echo "port 6379" >> /etc/redis.conf && \
    echo "daemonize no" >> /etc/redis.conf && \
    echo "databases 1" >> /etc/redis.conf && \
    echo "dir /var/lib/redis" >> /etc/redis.conf && \
    echo "logfile /var/log/redis/redis.log" >> /etc/redis.conf && \
    echo "loglevel notice" >> /etc/redis.conf && \
    echo "maxmemory 128mb" >> /etc/redis.conf && \
    echo "maxmemory-policy allkeys-lru" >> /etc/redis.conf && \
    echo "save \"\"" >> /etc/redis.conf && \
    echo "# No persistence - memory only for conversation cache" >> /etc/redis.conf

# Configure supervisor to manage Redis and Flask app
RUN echo "[supervisord]" > /etc/supervisor/conf.d/supervisord.conf && \
    echo "nodaemon=true" >> /etc/supervisor/conf.d/supervisord.conf && \
    echo "user=root" >> /etc/supervisor/conf.d/supervisord.conf && \
    echo "" >> /etc/supervisor/conf.d/supervisord.conf && \
    echo "[program:redis]" >> /etc/supervisor/conf.d/supervisord.conf && \
    echo "command=redis-server /etc/redis.conf" >> /etc/supervisor/conf.d/supervisord.conf && \
    echo "autostart=true" >> /etc/supervisor/conf.d/supervisord.conf && \
    echo "autorestart=true" >> /etc/supervisor/conf.d/supervisord.conf && \
    echo "user=root" >> /etc/supervisor/conf.d/supervisord.conf && \
    echo "stdout_logfile=/dev/stdout" >> /etc/supervisor/conf.d/supervisord.conf && \
    echo "stdout_logfile_maxbytes=0" >> /etc/supervisor/conf.d/supervisord.conf && \
    echo "stderr_logfile=/dev/stderr" >> /etc/supervisor/conf.d/supervisord.conf && \
    echo "stderr_logfile_maxbytes=0" >> /etc/supervisor/conf.d/supervisord.conf && \
    echo "" >> /etc/supervisor/conf.d/supervisord.conf && \
    echo "[program:flask]" >> /etc/supervisor/conf.d/supervisord.conf && \
    echo "command=gunicorn --bind 0.0.0.0:5000 --workers 2 --timeout 60 --preload --access-logfile - --error-logfile - app:app" >> /etc/supervisor/conf.d/supervisord.conf && \
    echo "directory=/app/backend" >> /etc/supervisor/conf.d/supervisord.conf && \
    echo "autostart=true" >> /etc/supervisor/conf.d/supervisord.conf && \
    echo "autorestart=true" >> /etc/supervisor/conf.d/supervisord.conf && \
    echo "user=root" >> /etc/supervisor/conf.d/supervisord.conf && \
    echo "stdout_logfile=/dev/stdout" >> /etc/supervisor/conf.d/supervisord.conf && \
    echo "stdout_logfile_maxbytes=0" >> /etc/supervisor/conf.d/supervisord.conf && \
    echo "stderr_logfile=/dev/stderr" >> /etc/supervisor/conf.d/supervisord.conf && \
    echo "stderr_logfile_maxbytes=0" >> /etc/supervisor/conf.d/supervisord.conf

# Create non-root user for security (but run supervisor as root for service management)
RUN addgroup -g 1001 -S appuser && adduser -S -u 1001 -G appuser appuser
RUN chown -R appuser:appuser /app

# Optimized health check
HEALTHCHECK --interval=60s --timeout=5s --start-period=30s --retries=2 \
    CMD curl -f http://localhost:5000/health || exit 1

EXPOSE 5000

# Start supervisor to manage Redis and Flask
WORKDIR /app/backend
CMD ["supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
