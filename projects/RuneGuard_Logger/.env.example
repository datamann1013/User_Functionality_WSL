# ErrorLogger Service Configuration
FLASK_ENV=development
FLASK_DEBUG=true

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE_PATH=./logs/
LOG_FILE_PREFIX=errorlog

# Service Configuration
ERRORLOGGER_PORT=5001
ERRORLOGGER_HOST=0.0.0.0

# CSV Configuration
LOG_FILE_ENCODING=utf-8
CSV_DELIMITER=;

# Remote Logging
REMOTE_LOG_TIMEOUT=5
FALLBACK_TO_LOCAL=true
