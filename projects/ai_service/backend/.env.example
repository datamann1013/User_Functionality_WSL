# AI Service Backend Configuration
FLASK_ENV=development
FLASK_DEBUG=true

# Error Logger Service
ERRORLOGGER_SERVICE_URL=http://localhost:5001/log

# Model Configuration
MODELS_DIR=./models
REGISTRY_PATH=./registry/models.json

# Hugging Face Configuration (optional - for gated models)
# HUGGINGFACE_TOKEN=your_token_here

# Resource Configuration
MAX_MODEL_MEMORY_GB=8
TORCH_DEVICE=auto
CACHE_DIR=./cache

# Security (for production)
# SECRET_KEY=your-secret-key-here
