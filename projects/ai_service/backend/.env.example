# RuneCore AI Service Backend Environment Configuration

# Service Configuration
PORT=5000
NODE_ENV=development
FLASK_ENV=development

# Database Configuration
DATABASE_URL=postgresql://runecore:runecore_secure_2024@localhost:5432/runecore_messages
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=runecore_messages
POSTGRES_USER=runecore
POSTGRES_PASSWORD=runecore_secure_2024

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION_DELTA=24

# Service URLs
ERRORLOGGER_SERVICE_URL=http://localhost:5001/log
MESSAGE_SERVICE_URL=http://localhost:5003
OLLAMA_SERVICE_URL=http://localhost:11434

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/ai_service.log

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Security
SECRET_KEY=your-secret-key-change-this-in-production
BCRYPT_LOG_ROUNDS=12

# AI Model Configuration
DEFAULT_MODEL=llama2
MODEL_TEMPERATURE=0.7
MAX_TOKENS=2048

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# File Upload Configuration
MAX_FILE_SIZE_MB=10
UPLOAD_FOLDER=uploads

# Performance Configuration
WORKER_CONNECTIONS=1000
WORKER_TIMEOUT=30
