# ErrorLogger Service Dockerfile
FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies (robust apt: IPv4 + retry)
ENV DEBIAN_FRONTEND=noninteractive
RUN set -eux; \
    sed -i 's|http://deb.debian.org/|https://deb.debian.org/|g' /etc/apt/sources.list || true; \
    echo 'Acquire::Retries "5";' > /etc/apt/apt.conf.d/80-retries; \
    for i in 1 2 3 4 5; do apt-get update -o Acquire::ForceIPv4=true -o Acquire::Retries=5 && break || (sleep 5); done; \
    apt-get install -y --no-install-recommends curl ca-certificates gnupg || (sleep 5 && apt-get install -y --no-install-recommends curl ca-certificates gnupg); \
    rm -rf /var/lib/apt/lists/*

# Install Python dependencies
RUN pip install --no-cache-dir \
    flask \
    flask-cors \
    requests \
    python-dotenv

# Copy ErrorLogger code
COPY projects/ErrorLogger/ /app/ErrorLogger/

# Create logs directory and set permissions
RUN mkdir -p /app/logs && chmod 755 /app/logs

# Create non-root user
RUN groupadd -r appuser && useradd -r -g appuser appuser
RUN chown -R appuser:appuser /app
USER appuser

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:5001/health || exit 1

# Expose port
EXPOSE 5001

# Start ErrorLogger service
CMD ["python", "/app/ErrorLogger/error_server.py"]
