# Optimized Ollama Service Dockerfile
FROM python:3.11-alpine

WORKDIR /app

# Install minimal dependencies
RUN apk add --no-cache curl

# Install only required Python packages
RUN pip install --no-cache-dir --disable-pip-version-check \
    flask==3.0.0 \
    flask-cors==4.0.0 \
    requests==2.31.0

# Copy optimized Ollama service code
COPY projects/ai_service/ollama_service/ /app/ollama_service/
COPY projects/ErrorLogger/ /app/ErrorLogger/

# Create logs directory
RUN mkdir -p /app/logs && chmod 777 /app/logs

# Create non-root user
RUN addgroup -g 1001 -S appuser && adduser -S -u 1001 -G appuser appuser
RUN chown -R appuser:appuser /app
USER appuser

# Optimized health check
HEALTHCHECK --interval=60s --timeout=3s --start-period=20s --retries=2 \
    CMD curl -f http://localhost:5002/health || exit 1

EXPOSE 5002

# Use lighter server configuration
CMD ["python", "/app/ollama_service/ollama_api.py"]
