# Ollama Service Dockerfile
FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
RUN pip install --no-cache-dir \
    flask \
    flask-cors \
    requests \
    python-dotenv

# Copy Ollama service code
COPY projects/ai_service/ollama_service/ /app/ollama_service/
COPY projects/ErrorLogger/ /app/ErrorLogger/

# Create logs directory and set permissions
RUN mkdir -p /app/logs && chmod 777 /app/logs

# Run as root for now to avoid permission issues
# TODO: Fix user permissions properly later

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:5002/health || exit 1

# Expose port
EXPOSE 5002

# Start Ollama service
CMD ["python", "/app/ollama_service/ollama_api.py"]
