# Optimized Backend API Dockerfile
FROM python:3.11-alpine

# Set working directory
WORKDIR /app

# Install only essential system dependencies in a single layer
RUN apk add --no-cache curl postgresql-client

# Copy requirements and install Python dependencies
COPY backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir --disable-pip-version-check -r requirements.txt \
    && pip install --no-cache-dir psycopg2-binary gunicorn

# Copy application code (optimized layering)
COPY backend/ /app/backend/
COPY ../shared_utils/ /app/shared_utils/
COPY ../ErrorLogger/ /app/ErrorLogger/

# Create necessary directories
RUN mkdir -p /app/uploads /app/logs && chmod 755 /app/uploads && chmod 777 /app/logs

# Create non-root user for security
RUN addgroup -g 1001 -S appuser && adduser -S -u 1001 -G appuser appuser
RUN chown -R appuser:appuser /app
USER appuser

# Optimized health check
HEALTHCHECK --interval=60s --timeout=5s --start-period=30s --retries=2 \
    CMD curl -f http://localhost:5000/health || exit 1

EXPOSE 5000

# Optimized Gunicorn configuration
WORKDIR /app/backend
CMD ["gunicorn", "--bind", "0.0.0.0:5000", "--workers", "2", "--timeout", "60", "--preload", "--access-logfile", "-", "--error-logfile", "-", "app:app"]
