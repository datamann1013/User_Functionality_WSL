# Backend API Dockerfile
FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies (use IPv4 and retries for flaky networks)
ENV DEBIAN_FRONTEND=noninteractive
# Prefer HTTPS mirrors and add retry settings to apt to tolerate transient network issues
RUN set -eux; \
     sed -i 's|http://deb.debian.org/|https://deb.debian.org/|g' /etc/apt/sources.list || true; \
     echo 'Acquire::Retries "5";' > /etc/apt/apt.conf.d/80-retries; \
     for i in 1 2 3 4 5; do apt-get update -o Acquire::ForceIPv4=true -o Acquire::Retries=5 && break || (sleep 5); done; \
     apt-get install -y --no-install-recommends \
         curl \
         ca-certificates \
         gnupg \
         postgresql-client \
     && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
# Copy requirements first for better layer caching
COPY projects/ai_service/backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Install additional packages for production
RUN pip install --no-cache-dir \
    psycopg2-binary \
    redis \
    cryptography \
    gunicorn

# Copy application code
COPY projects/ai_service/backend/ /app/backend/
COPY projects/shared_utils/ /app/shared_utils/
COPY projects/ErrorLogger/ /app/ErrorLogger/

# Create uploads directory
RUN mkdir -p /app/uploads && chmod 755 /app/uploads

# Create non-root user
RUN groupadd -r appuser && useradd -r -g appuser appuser
RUN chown -R appuser:appuser /app
USER appuser

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:5000/health || exit 1

# Expose port
EXPOSE 5000

# Start application with Gunicorn for production
WORKDIR /app/backend
CMD ["gunicorn", "--bind", "0.0.0.0:5000", "--workers", "4", "--timeout", "120", "--access-logfile", "-", "--error-logfile", "-", "app:app"]
