# Backend API Dockerfile
FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
# Copy requirements first for better layer caching
COPY projects/ai_service/backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Install additional packages for production
RUN pip install --no-cache-dir \
    psycopg2-binary \
    redis \
    cryptography \
    gunicorn

# Copy application code
COPY projects/ai_service/backend/ /app/backend/
COPY projects/shared_utils/ /app/shared_utils/
COPY projects/ErrorLogger/ /app/ErrorLogger/

# Create uploads directory
RUN mkdir -p /app/uploads && chmod 755 /app/uploads
RUN mkdir -p /app/logs && chmod 777 /app/logs

# Run as root for now to avoid permission issues  
# TODO: Fix user permissions properly later

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:5000/health || exit 1

# Expose port
EXPOSE 5000

# Start application with Gunicorn for production
WORKDIR /app/backend
CMD ["gunicorn", "--bind", "0.0.0.0:5000", "--workers", "4", "--timeout", "120", "--access-logfile", "-", "--error-logfile", "-", "app:app"]
