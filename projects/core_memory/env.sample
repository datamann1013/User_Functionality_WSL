# CoreMemory environment variables
CORE_MEMORY__STORAGE=postgres
POSTGRES_DSN=postgres://user:pass@postgres:5432/corememory
REDIS_URL=redis://redis:6379/0
INFLUX_URL=http://influx:8086
PGVECTOR_ENABLED=true
BACKUP_DIR=/var/lib/corememory/backups
DEFAULT_NAMESPACE=global
LOG_LEVEL=info
ENABLE_AUTH=false
RETENTION_DEFAULT_DAYS=0
