# RuneCore Ecosystem Environment Configuration
# Copy this file to .env and update with your secure values

# ============================================================================
# CORE CONFIGURATION
# ============================================================================
CA_PASSPHRASE=changeme_in_production
DISABLE_MTLS=false
AUTO_RESTART_SERVICES=true

# ============================================================================
# SECURITY
# ============================================================================
JWT_SECRET_KEY=change_this_to_a_secure_random_key
ALLOWED_ORIGINS=http://localhost:3000,http://localhost

# ============================================================================
# DATABASE CREDENTIALS
# ============================================================================
POSTGRES_PASSWORD=change_this_postgres_password
REDIS_PASSWORD=change_this_redis_password
INFLUX_PASSWORD=change_this_influx_password
INFLUX_TOKEN=change_this_influx_token

# ============================================================================
# SERVICE CONFIGURATION
# ============================================================================
COMPOSE_PROJECT_NAME=runecore
BACKUP_RETENTION_COUNT=2
BACKUP_KEEP_MONTHLY=true
INFLUX_RETENTION_DAYS=90
OFFLINE_PERMANENT_THRESHOLD=10

# ============================================================================
# OPERATIONAL
# ============================================================================
# Set to temporary threshold (seconds) before marking service permanently offline
# Default: 600 seconds (10 minutes)
OFFLINE_TEMP_TO_PERM_SECONDS=600
